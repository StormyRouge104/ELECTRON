import discord
from discord import app_commands
class Golosovanie (discord.ui.Modal):# !!!!! ПЕРВЫЙ КЛАСС
    def __init__(self):
        super().__init__(title="Первый этап голосования 104 AWARDS!")
        self.nominee = discord.ui.TextInput(label="Категория", placeholder="Хуйло года")
        self.who = discord.ui.TextInput(label="потенциальные номинанты", style=discord.TextStyle.paragraph, placeholder="Вова Бобейн, Влад Бобейн и т.д")
        self.whyhim = discord.ui.TextInput(label="за шо???", style=discord.TextStyle.paragraph, placeholder="вова бобенис за то что хуйло, влад бобейн за то шо хуйлопан(ссылка на видео/изображение).")
        self.add_item(self.nominee)
        self.add_item(self.who)
        self.add_item(self.whyhim)
    async def on_submit(self, interaction):
        await interaction.response.defer(ephemeral=True)
        results = await interaction.client.fetch_user(1137764637794893856)
        await results.send(f"категория - {self.nominee.value}, хто - {self.who.value}, за шо - {self.whyhim.value}, от {interaction.user.mention}")
        await interaction.followup.send("яйца", ephemeral=True)

class confirmer(discord.ui.view): # !!!!!!!!! третий клаасс



class introduction (discord.ui.View): # !!!! ВТОРОЙ КЛАСС
    @discord.ui.button(label="Предложить яйца", style=discord.ButtonStyle.green)
    async def modalnyi(self, interaction:discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_modal(Golosovanie())
async def setup (bot):

    @bot.tree.command(name="votestage1", description ="голосовать в 104 авардсах")
    @app_commands.allowed_contexts(guilds=True, dms=True, private_channels= True)
    async def stage1(interaction):
        await interaction.response.send_message("Добро пожаловать в первый этап 104 AWARDS 2026! 104 AWARDS будет разделён на 3 этапа: первый - предложите свои категории, каких потенциально людей можно туда вписать и за что (Неизвестный Девственнeик в маске не гарантирует что каждая ваша категория/каждый ваш потенциальный предложенный человек попадёт во второй этап). Второй - голосуйте в категориях за лучшую мразь в своей категории. Третий этап - само шоу", ephemeral=True, view=introduction())

